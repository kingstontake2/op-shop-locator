# Browser Maps JS + Places (HTTP referrer restrictions OK — localhost + your Vercel domain).
GOOGLE_MAPS_API_KEY=

# Optional alias; if unset, GOOGLE_MAPS_API_KEY is used for the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: unrestricted (or IP-restricted) key for /api/nearby server routes.
# Referrer-restricted keys cannot call Places Web Service from the server.
# GOOGLE_MAPS_SERVER_KEY=
