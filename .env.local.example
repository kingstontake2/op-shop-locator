# Browser Maps JS + Places (HTTP referrer restrictions OK — localhost + your Vercel domain).
GOOGLE_MAPS_API_KEY=

# Optional alias; if unset, GOOGLE_MAPS_API_KEY is used for the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Required for cached server-side Places searches. Do not prefix with NEXT_PUBLIC.
# Vercel has dynamic IPs, so enable Places API and leave application restriction unset.
GOOGLE_MAPS_SERVER_KEY=

# Shared Upstash Redis is fine; all app keys are prefixed with "opshop:".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
