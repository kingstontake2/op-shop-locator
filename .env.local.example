# Browser Maps JS + Places (HTTP referrer restrictions OK — localhost + your Vercel domain).
GOOGLE_MAPS_API_KEY=

# Optional alias; if unset, GOOGLE_MAPS_API_KEY is used for the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Required for cached server-side Places searches. Do not prefix with NEXT_PUBLIC.
# Vercel has dynamic IPs, so enable Places API and leave application restriction unset.
GOOGLE_MAPS_SERVER_KEY=

# Shared Upstash Redis is fine; all app keys are prefixed with "opshop:".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private /admin/usage dashboard token (never expose as NEXT_PUBLIC_*).
USAGE_DASHBOARD_TOKEN=

# Optional free-tier caps / circuit-breaker thresholds (defaults shown in docs/usage-monitoring.md).
# USAGE_CAP_NEARBY=5000
# USAGE_BLOCK_NEARBY=4000
# USAGE_CAP_TEXT_SEARCH=5000
# USAGE_BLOCK_TEXT_SEARCH=4000
# USAGE_CAP_DETAILS=1000
# USAGE_BLOCK_DETAILS=800
# USAGE_CAP_PHOTOS=1000
# USAGE_BLOCK_PHOTOS=800
# USAGE_CAP_MAP_LOADS=10000
# USAGE_CAP_REDIS=500000
